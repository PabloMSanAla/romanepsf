+                )
+
+                tier_data[t] = {
+                    "observed": obs,
+                    "model": mod,
+                    "residual": res,
+                    "norm_res": nres,
+                    "frac_res": fres,
+                    "mask": mask,
+                    "mag": float(hdr.get("MAG", 0.0)),
+                    "flxscale": float(hdr.get("FLXSCALE", 1.0)),
+                    "dx": float(hdr.get("DX", 0.0)),
+                    "dy": float(hdr.get("DY", 0.0)),
+                    "chi2_nu": float(hdr.get("CHI2_NU", 0.0)),
+                    "source_id": str(hdr.get("SRC_ID", best_f.stem)),
+                    "is_mock": False,
